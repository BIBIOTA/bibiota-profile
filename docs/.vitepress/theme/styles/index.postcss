@tailwind base;
@tailwind components;
@tailwind utilities;

* {
  box-sizing: border-box;
}

body {
  overflow-x: hidden;
}

.VPContent {
  max-width: 100vw;
  overflow-x: hidden;
}

/* 隱藏 resume 頁面的 VitePress 自動產生標題 */
.vp-doc._resume h1#resume,
.vp-doc h1[id="resume"] {
  display: none !important;
}

/* Reset VitePress 1.x heading styles inside index about card */
.vp-doc .index_about_card h1,
.vp-doc .index_about_card h2 {
  margin: 0;
  padding-top: 0;
  border-top: none;
  letter-spacing: normal;
}
